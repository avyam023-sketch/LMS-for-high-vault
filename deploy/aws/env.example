# /etc/high-vault/env: the site's settings on the server. install.sh creates it with new secrets.
# Edit with:  sudo nano /etc/high-vault/env   then run  sudo bash deploy/aws/install.sh  again.

# The address learners use (point its DNS A record at the instance's static IP first).
APP_URL=https://learn.thehighvaultsecurity.ca

# Lightsail → Databases → your database → Connect: user, password, endpoint and database name.
DATABASE_URL=postgres://dbmasteruser:PASSWORD@ENDPOINT.ca-central-1.rds.amazonaws.com:5432/highvault

SESSION_SECRET=
ENCRYPTION_KEY=

# First boot: load the course and create the first admin. Delete ADMIN_PASSWORD after you've signed in.
SEED_ON_START=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
MAIL_FROM=The High Vault Security <no-reply@thehighvaultsecurity.ca>
SUPPORT_EMAIL=info@thehighvaultsecurity.ca

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

BUNNY_STREAM_TOKEN_KEY=

# Set by install.sh; leave as they are.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
DATABASE_CA_FILE=/etc/high-vault/rds-global-bundle.pem
