# deploy/aws/.env — read by docker compose. setup.sh fills in the two secrets. Never commit this file.

# The address learners use, without https:// (point its DNS A record at the instance's static IP first).
DOMAIN=learn.thehighvaultsecurity.ca

# Lightsail → Databases → your database → Connect: user, password, endpoint and database name.
DATABASE_URL=postgres://dbmasteruser:PASSWORD@ENDPOINT.ca-central-1.rds.amazonaws.com:5432/highvault

SESSION_SECRET=
ENCRYPTION_KEY=

# First boot: load the course and create the first admin. Delete ADMIN_PASSWORD after you've signed in.
SEED_ON_START=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sample learners for a demo. Keep false on the real site.
SEED_SAMPLE_DATA=false

REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
MAIL_FROM=The High Vault Security <no-reply@thehighvaultsecurity.ca>
SUPPORT_EMAIL=info@thehighvaultsecurity.ca

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

BUNNY_STREAM_TOKEN_KEY=
