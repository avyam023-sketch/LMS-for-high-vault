# Local preview on your own computer: `npm run preview`, then open http://localhost:3000
# Sign in as admin@example.com / vault-preview-2026, or register as a learner.
#
# FOR YOUR OWN COMPUTER ONLY. These keys are public placeholders, email confirmation and admin two-step
# verification are off, and the app refuses to start in production with them.
#
# Needs PostgreSQL with an empty database called highvault_preview. If your PostgreSQL user or password
# differ, change DATABASE_URL below (or set DATABASE_URL in your terminal, which takes precedence).
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/highvault_preview
SESSION_SECRET=local-preview-only-not-a-real-secret-do-not-deploy
ENCRYPTION_KEY=bG9jYWwtcHJldmlldy1vbmx5LW5vdC1zZWNyZXQhIQA=
SEED_ON_START=true
SEED_SAMPLE_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=vault-preview-2026
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_ADMIN_MFA=false
CHECK_BREACHED_PASSWORDS=false
# To try paying for the course, add a Stripe test key (test card 4242 4242 4242 4242):
# STRIPE_SECRET_KEY=sk_test_...
