{
  "name": "high-vault-academy",
  "version": "1.0.0",
  "private": true,
  "description": "The High Vault Security Academy — online training, exams and certificates.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "rotate-keys": "node --env-file-if-exists=.env scripts/rotate-keys.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "gsap": "3.15.0",
    "helmet": "^8.3.0",
    "marked": "^18.1.2",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
