# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_URL=postgres://hv:hv_dev_pw@localhost:5432/highvault
# DATABASE_SSL=true            # set when your managed Postgres requires TLS

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# During a key rotation only: the old key(s), comma-separated. See README → Key rotation.
# ENCRYPTION_KEYS_PREVIOUS=

# Behind a reverse proxy / load balancer (Caddy, nginx, a cloud load balancer): set to the number of proxy hops, e.g. 1
TRUST_PROXY=loopback

REQUIRE_ADMIN_MFA=true
REQUIRE_EMAIL_VERIFICATION=true
# Checks new passwords against known breaches (k-anonymity). On by default in production.
CHECK_BREACHED_PASSWORDS=true

# Email. Recommended: Resend (resend.com → API Keys). Verify your sending domain in Resend first.
# Or any SMTP server via SMTP_URL. Without either, emails print to the server console (development only).
# RESEND_API_KEY=re_...
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="THVFoodSafe <no-reply@thehighvaultsecurity.ca>"
SUPPORT_EMAIL=info@thehighvaultsecurity.ca

# Exam ID photos, room scans and snapshots are deleted this many days after a decision…
PROCTOR_RETENTION_AFTER_DECISION_DAYS=30
# …and never kept longer than this, decided or not.
PROCTOR_RETENTION_DAYS=90

# First-run setup on a fresh server (safe to leave on): load the course, create the first admin.
# Remove ADMIN_PASSWORD once the admin exists.
# SEED_ON_START=true
# ADMIN_EMAIL=you@thehighvaultsecurity.ca
# ADMIN_PASSWORD=

# Chapter videos on Bunny Stream: Stream → your library → Security → enable "Embed view token authentication",
# then copy the "Token authentication key" here. Links to each video are then signed and expire after 6 hours.
# BUNNY_STREAM_TOKEN_KEY=

# Payments with Stripe Checkout. Without a key, enrolling in a paid course is refused.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
