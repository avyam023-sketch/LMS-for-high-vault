# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_URL=postgres://hv:hv_dev_pw@localhost:5432/highvault
# DATABASE_SSL=true            # set when your managed Postgres requires TLS

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Behind a reverse proxy / load balancer (Render, Railway, Fly, nginx): set to the number of proxy hops, e.g. 1
TRUST_PROXY=loopback

REQUIRE_ADMIN_MFA=true
REQUIRE_EMAIL_VERIFICATION=true
CHECK_BREACHED_PASSWORDS=true

# Email. Without SMTP_URL, emails print to the server console (development only).
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="The High Vault Security <no-reply@thehighvaultsecurity.ca>"
SUPPORT_EMAIL=info@thehighvaultsecurity.ca

# Days to keep exam ID photos, room scans and snapshots before automatic deletion.
PROCTOR_RETENTION_DAYS=90

# Optional: charge for the course with Stripe Checkout. Leave blank for free enrolment.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
