<%- include('../partials/head') %>
<main id="main" class="auth">
  <div class="card">
    <h1>Sign in</h1>
    <p class="muted">Welcome back. Pick up where you left off.</p>
    <%- include('../partials/flash') %>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', value: values.email, autocomplete: 'username' }) %>
      <%- include('../partials/field', { name: 'password', label: 'Password', type: 'password', value: '', autocomplete: 'current-password' }) %>
      <p class="small"><a href="/forgot-password">Forgot your password?</a></p>
      <button class="btn btn-primary btn-block btn-lg" type="submit">Sign in</button>
    </form>
    <p class="divider">New here? <a href="/register">Create an account</a></p>
  </div>
</main>
<%- include('../partials/foot') %>
