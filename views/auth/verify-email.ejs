<%- include('../partials/head') %>
<main id="main" class="auth">
  <div class="card center">
    <p class="eyebrow">One more step</p>
    <h1>Confirm your email</h1>
    <%- include('../partials/flash') %>
    <p class="muted">We sent a confirmation link to <strong><%= user.email %></strong>. Open it to start your course. Check your spam folder if you don't see it within a few minutes.</p>
    <form method="post" action="/verify-email/resend" class="mt-24">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <button class="btn btn-ghost" type="submit">Send a new link</button>
    </form>
  </div>
</main>
<%- include('../partials/foot') %>
