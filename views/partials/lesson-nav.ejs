<nav class="lesson-nav" aria-label="Course lessons">
  <% let n = 0; outline.modules.forEach((m, i) => { %>
    <h4><span><%= String(i + 1).padStart(2, '0') %></span><%= m.title %></h4>
    <% for (const l of m.lessons) { n++; %>
      <% if (l.unlocked) { %>
        <a href="/learn/<%= course.slug %>/lessons/<%= l.id %>" <%- locals.currentId === l.id ? 'aria-current="page"' : '' %>>
          <span class="dot <%= l.done ? 'done' : '' %>"><% if (l.done) { %><%- include('icon', { name: 'check', cls: '' }) %><% } %></span><span><%= l.title %><% if (l.done) { %><span class="sr-only"> (complete)</span><% } %></span>
        </a>
      <% } else { %>
        <span class="locked" title="Complete the previous lesson to unlock"><span class="dot"></span><span><%= l.title %><span class="sr-only"> (locked)</span></span></span>
      <% } %>
    <% } %>
  <% }) %>
  <div class="exam-link">
    <a class="btn <%= outline.allDone ? 'btn-primary' : 'btn-ghost' %> btn-block btn-sm" href="/learn/<%= course.slug %>/exam"><%= outline.allDone ? 'Final exam' : 'Final exam · locked' %></a>
  </div>
</nav>
