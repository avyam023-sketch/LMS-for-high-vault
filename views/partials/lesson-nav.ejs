<nav class="lesson-nav" aria-label="Course lessons">
  <% outline.modules.forEach((m, i) => { %>
    <h4>Module <%= i + 1 %> · <%= m.title %></h4>
    <% for (const l of m.lessons) { %>
      <% if (l.unlocked) { %>
        <a href="/learn/<%= course.slug %>/lessons/<%= l.id %>" <%- locals.currentId === l.id ? 'aria-current="page"' : '' %>>
          <span class="dot <%= l.done ? 'done' : '' %>"><% if (l.done) { %><%- include('icon', { name: 'check', cls: '' }) %><% } %></span><span><%= l.title %></span>
        </a>
      <% } else { %>
        <span class="locked" title="Complete the previous lesson to unlock"><span class="dot"></span><span><%= l.title %></span></span>
      <% } %>
    <% } %>
  <% }) %>
  <div class="exam-link">
    <a class="btn <%= outline.allDone ? 'btn-primary' : 'btn-ghost' %> btn-block btn-sm" href="/learn/<%= course.slug %>/exam">Final exam<%= outline.allDone ? '' : ' (locked)' %></a>
  </div>
</nav>
