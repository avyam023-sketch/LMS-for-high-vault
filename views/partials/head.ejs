<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} — The High Vault Security` : 'Food Handler Certification — The High Vault Security' %></title>
  <meta name="description" content="<%= locals.description || 'Online food handler certification from The High Vault Security. Study at your own pace, pass the final exam, and download a certificate employers can verify.' %>">
  <meta name="theme-color" content="#231F20">
  <% const pageTitle = title ? `${title} — The High Vault Security` : 'Food Handler Certification — The High Vault Security'; const pageDesc = locals.description || 'Online food handler certification from The High Vault Security. Study at your own pace, pass the final exam, and download a certificate employers can verify.'; %>
  <% if (!user && !path.startsWith('/admin')) { %>
  <link rel="canonical" href="<%= appUrl %><%= path %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The High Vault Security">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= appUrl %><%= path %>">
  <meta property="og:image" content="<%= appUrl %>/img/og-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_CA">
  <meta name="twitter:card" content="summary_large_image">
  <% } else { %>
  <meta name="robots" content="noindex">
  <% } %>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/fonts/plex-sans/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/jost/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css">
  <% if (locals.motion || locals.cards) { %><script src="/js/motion-init.js"></script><% } %>
  <% if (locals.motion) { %><script src="/vendor/gsap/gsap.min.js" defer></script>
  <script src="/vendor/gsap/ScrollTrigger.min.js" defer></script>
  <script src="/js/motion.js" defer></script>
  <% } %>
  <script src="/js/site.js" defer></script>
  <% if (locals.scripts) { for (const s of scripts) { %><script src="<%= s %>" defer></script>
  <% } } %>
  <% if (locals.moduleScripts) { for (const s of moduleScripts) { %><script type="module" src="<%= s %>"></script>
  <% } } %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="The High Vault Security — home">
      <img src="/img/logo-lockup.svg" alt="The High Vault Security" width="121" height="44">
      <span class="brand-tag">Food Handler<br>Certification</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span></span>Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <% if (user) { %>
        <a href="/dashboard" <%- path.startsWith('/dashboard') || path.startsWith('/learn') ? 'aria-current="page"' : '' %>>My learning</a>
        <% if (user.role === 'admin' || user.role === 'reviewer') { %><a href="/admin" <%- path.startsWith('/admin') ? 'aria-current="page"' : '' %>><%= user.role === 'admin' ? 'Admin' : 'Reviews' %></a><% } %>
        <a href="/verify" <%- path.startsWith('/verify') ? 'aria-current="page"' : '' %>>Verify</a>
        <a href="/account" <%- path.startsWith('/account') ? 'aria-current="page"' : '' %>>Account</a>
        <span class="divider-v" aria-hidden="true"></span>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="link" type="submit">Sign out</button></form>
      <% } else { %>
        <a href="/#curriculum">Curriculum</a>
        <a href="/#certificate">Certificate</a>
        <a href="/#faq">FAQ</a>
        <a href="/verify" <%- path.startsWith('/verify') ? 'aria-current="page"' : '' %>>Verify a certificate</a>
        <span class="divider-v" aria-hidden="true"></span>
        <a href="/login" <%- path === '/login' ? 'aria-current="page"' : '' %>>Sign in</a>
        <a class="btn btn-ice btn-sm" href="/register">Enrol now</a>
      <% } %>
    </nav>
  </div>
</header>
