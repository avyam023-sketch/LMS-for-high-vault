<% if (page > 1 || hasMore) { const qs = (p) => { const u = new URLSearchParams(params || {}); u.set('page', p); return '?' + u.toString(); }; %>
<nav class="pager" aria-label="Pagination">
  <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page - 1) %>">← Newer</a><% } %>
  <% if (hasMore) { %><a class="btn btn-ghost btn-sm" href="<%= qs(page + 1) %>">Older →</a><% } %>
</nav>
<% } %>
