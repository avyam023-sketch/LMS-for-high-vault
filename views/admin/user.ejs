<%- include('../partials/admin-start') %>
<% const act = (action, label, cls = 'btn-ghost', confirmMsg = '') => `
  <form method="post" action="/admin/users/${member.id}/action" class="inline-form"${confirmMsg ? ` data-confirm="${confirmMsg}"` : ''}>
    <input type="hidden" name="_csrf" value="${csrfToken()}"><input type="hidden" name="action" value="${action}">
    <button class="btn ${cls} btn-sm" type="submit">${label}</button></form>`; %>
<p class="crumb"><a href="/admin/users">← Learners</a></p>
<div class="page-head">
  <div>
    <h1 class="mb-8"><%= member.first_name %> <%= member.last_name %></h1>
    <div class="row">
      <span class="ref"><%= member.reference %></span>
      <span class="muted"><%= member.email %></span>
      <% if (member.role !== 'student') { %><span class="badge badge-dark"><%= member.role === 'admin' ? 'Admin' : 'Reviewer' %></span><% } %>
      <% if (member.disabled_at) { %><span class="badge badge-bad">Disabled</span><% } %>
      <% if (!member.email_verified_at) { %><span class="badge badge-warn">Email unverified</span><% } %>
      <% if (member.mfa_enabled_at) { %><span class="badge badge-ok">2-step on</span><% } %>
      <% if (member.locked_until && new Date(member.locked_until) > new Date()) { %><span class="badge badge-bad">Locked</span><% } %>
    </div>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <h2>Details</h2>
    <dl class="meta">
      <dt>Joined</dt><dd><%= fmtDateTime(member.created_at) %></dd>
      <dt>Last sign-in</dt><dd><%= fmtDateTime(member.last_login_at) %></dd>
      <dt>Email verified</dt><dd><%= fmtDateTime(member.email_verified_at) %></dd>
      <dt>Signed in now</dt><dd><%= member.active_session_id ? 'Yes (one device)' : 'No' %></dd>
    </dl>
    <h3 class="mt-24">Correct legal name</h3>
    <form method="post" action="/admin/users/<%= member.id %>/action" class="row" data-confirm="Change this learner's name? Existing certificates keep the old name.">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>"><input type="hidden" name="action" value="rename">
      <input class="grow" name="first_name" value="<%= member.first_name %>" aria-label="First name" required>
      <input class="grow" name="last_name" value="<%= member.last_name %>" aria-label="Last name" required>
      <button class="btn btn-ghost btn-sm" type="submit">Save</button>
    </form>
  </section>
  <section class="card">
    <h2>Actions</h2>
    <div class="row">
      <% if (!member.email_verified_at) { %><%- act('verify_email', 'Mark email verified') %><% } %>
      <%- act('sign_out', 'Sign out everywhere') %>
      <% if (member.mfa_enabled_at) { %><%- act('reset_mfa', 'Reset 2-step', 'btn-ghost', 'Remove this user’s two-step verification?') %><% } %>
      <% if (member.role !== 'student') { %><%- act('make_student', 'Remove staff access', 'btn-ghost', 'Remove this person’s staff access?') %><% } %>
      <% if (member.role !== 'reviewer') { %><%- act('make_reviewer', 'Make identity reviewer', 'btn-ghost', 'Let this person review exam recordings and ID photos? They will see nothing else in the dashboard.') %><% } %>
      <% if (member.role !== 'admin') { %><%- act('make_admin', 'Make admin', 'btn-ghost', 'Give this user full admin access, including all learner data?') %><% } %>
      <% if (member.disabled_at) { %><%- act('enable', 'Enable account', 'btn-primary') %>
      <% } else { %><%- act('disable', 'Disable account', 'btn-danger', 'Disable this account and sign it out?') %><% } %>
    </div>
    <h3 class="mt-24">Enrol in a course</h3>
    <form method="post" action="/admin/users/<%= member.id %>/action" class="row">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>"><input type="hidden" name="action" value="enroll">
      <select name="course_id" class="grow" aria-label="Course"><% for (const c of courses) { %><option value="<%= c.id %>"><%= c.title %></option><% } %></select>
      <button class="btn btn-ghost btn-sm" type="submit">Enrol</button>
    </form>
  </section>
</div>

<h2 class="mt-32">Enrolments</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Course</th><th>Enrolled</th><th>Lessons</th><th>Attempts</th><th>Completed</th><th></th></tr></thead>
    <tbody>
      <% for (const e of enrollments) { const used = attempts.filter((a) => a.course_id === e.course_id).length %>
      <tr>
        <td><%= e.title %> <span class="badge"><%= e.source %></span></td>
        <td><%= fmtDate(e.enrolled_at) %></td>
        <td><%= e.lessons_done %> / <%= e.lessons_total %></td>
        <td><%= used %> of <%= e.max_attempts + e.extra_attempts %></td>
        <td><%= fmtDate(e.completed_at) %></td>
        <td>
          <form method="post" action="/admin/users/<%= member.id %>/action" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>"><input type="hidden" name="action" value="extra_attempt"><input type="hidden" name="course_id" value="<%= e.course_id %>">
            <button class="btn btn-ghost btn-sm" type="submit">+1 attempt</button>
          </form>
        </td>
      </tr>
      <% } %>
      <% if (!enrollments.length) { %><tr><td colspan="6" class="muted">Not enrolled.</td></tr><% } %>
    </tbody>
  </table>
</div>

<h2 class="mt-32">Exam attempts</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Started</th><th>Reference</th><th>Course</th><th class="num">Score</th><th>Result</th><th>IP</th></tr></thead>
    <tbody>
      <% for (const a of attempts) { %>
      <tr><td><a href="/admin/attempts/<%= a.id %>"><%= fmtDateTime(a.started_at) %></a></td><td><span class="ref small"><%= a.reference %></span></td><td><%= a.course_title %></td>
        <td class="num"><%= a.score_percent ?? '—' %></td><td><%- include('../partials/attempt-badge', { a }) %></td><td><%= a.ip %></td></tr>
      <% } %>
      <% if (!attempts.length) { %><tr><td colspan="6" class="muted">No attempts.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (payments.length) { %>
<h2 class="mt-32" id="payments">Payments</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Date</th><th>Reference</th><th>Course</th><th class="num">Amount</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const p of payments) { %>
      <tr><td><%= fmtDateTime(p.paid_at ?? p.created_at) %></td><td><span class="ref small"><%= p.reference %></span></td><td><%= p.course_title %></td>
        <td class="num"><%= money(p.amount_cents, p.currency) %></td>
        <td><span class="badge <%= p.status === 'paid' ? 'badge-ok' : p.status === 'failed' ? 'badge-bad' : '' %>"><%= p.status === 'paid' ? 'Paid' : p.status === 'failed' ? 'Failed' : 'Not completed' %></span></td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

<h2 class="mt-32">Certificates</h2>
<%- include('../partials/cert-table', { certificates, showUser: false }) %>

<h2 class="mt-32">Recent activity</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>When</th><th>Action</th><th>IP</th></tr></thead>
    <tbody>
      <% for (const a of activity) { %><tr><td><%= fmtDateTime(a.created_at) %></td><td><code><%= a.action %></code></td><td><%= a.ip %></td></tr><% } %>
      <% if (!activity.length) { %><tr><td colspan="3" class="muted">No activity.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/admin-end') %>
