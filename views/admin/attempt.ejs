<%- include('../partials/admin-start', { scripts: ['/js/admin-media.js'] }) %>
<% const labels = { tab_hidden: 'Switched tab / minimised', window_blur: 'Left the exam window', fullscreen_exit: 'Exited full screen', copy: 'Tried to copy', paste: 'Tried to paste', context_menu: 'Right-click', print: 'Tried to print', devtools: 'Developer tools shortcut', shortcut: 'Blocked keyboard shortcut',
  camera_off: 'Camera turned off', camera_restored: 'Camera back on', second_screen: 'Second screen connected', no_face: 'No face in view', multiple_faces: 'More than one person in view', noise: 'Sustained sound or talking', face_check_skipped: 'Photo taken without face detection', detector_unavailable: 'Face detection unavailable on device' };
   const reviewKinds = ['no_face', 'multiple_faces', 'noise', 'face_check_skipped', 'detector_unavailable']; %>
<p class="crumb"><a href="/admin/attempts">← Exam attempts</a></p>
<div class="page-head">
  <div>
    <h1 class="mb-8"><% if (user.role === 'admin') { %><a href="/admin/users/<%= attempt.user_id %>"><%= attempt.first_name %> <%= attempt.last_name %></a><% } else { %><%= attempt.first_name %> <%= attempt.last_name %><% } %></h1>
    <div class="row"><span class="muted"><%= attempt.course_title %></span><%- include('../partials/attempt-badge', { a: attempt }) %></div>
  </div>
  <% if (attempt.score_percent != null) { %><div class="score"><%= attempt.score_percent %>%</div><% } %>
</div>

<% if (attempt.review_status === 'pending') { %>
  <div class="alert alert-info"><strong>Waiting for identity review.</strong> This learner passed. Check that the ID matches the face photo and the name on file, that the room scan shows no one else and no devices within reach, and look through the snapshots and flagged events below. Approving issues the certificate.</div>
<% } else if (attempt.review_status === 'approved') { %>
  <div class="alert alert-success">Approved by <%= reviewer ? reviewer.email : 'an administrator' %> on <%= fmtDateTime(attempt.reviewed_at) %><%= attempt.review_note ? ` — ${attempt.review_note}` : '' %>.</div>
<% } else if (attempt.review_status === 'rejected') { %>
  <div class="alert alert-error">Rejected by <%= reviewer ? reviewer.email : 'an administrator' %> on <%= fmtDateTime(attempt.reviewed_at) %> — <%= attempt.review_note %>.</div>
<% } %>

<% if (face || idPhoto || roomScan) { %>
<section class="card mb-24">
  <div class="spread mb-16"><h2 class="mb-0">Identity check</h2><span class="small muted">Name on file: <strong><%= attempt.first_name %> <%= attempt.last_name %></strong></span></div>
  <div class="evidence">
    <figure><% if (face) { %><a href="/admin/media/<%= face.id %>" target="_blank" rel="noopener"><img src="/admin/media/<%= face.id %>" alt="Learner face photo"></a><% } else { %><div class="evidence-missing">No face photo</div><% } %><figcaption>Face photo<%= face ? ` · ${fmtDateTime(face.created_at)}` : '' %></figcaption></figure>
    <figure><% if (idPhoto) { %><a href="/admin/media/<%= idPhoto.id %>" target="_blank" rel="noopener"><img src="/admin/media/<%= idPhoto.id %>" alt="Learner ID photo"></a><% } else { %><div class="evidence-missing">No ID photo</div><% } %><figcaption>Government ID<%= idPhoto ? ` · ${fmtDateTime(idPhoto.created_at)}` : '' %></figcaption></figure>
    <figure class="wide"><% if (roomScan) { %><video src="/admin/media/<%= roomScan.id %>" controls preload="metadata" data-fix-duration></video><% } else { %><div class="evidence-missing">No room scan</div><% } %><figcaption>Room scan<%= roomScan ? ` · ${Math.round(roomScan.byte_size / 1024 / 102.4) / 10} MB` : '' %></figcaption></figure>
  </div>
  <div class="spread mt-16">
    <p class="small muted mb-0">Encrypted at rest. Every view is logged. Deleted automatically <%= decisionDays %> days after a decision, and never kept longer than <%= retentionDays %> days.</p>
    <% if (user.role === 'admin' && attempt.review_status !== 'pending' && !['checkin', 'in_progress'].includes(attempt.status)) { %>
      <form method="post" action="/admin/attempts/<%= attempt.id %>/purge-evidence" data-confirm="Permanently delete this attempt’s ID photo, face photo, room scan and snapshots?">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button class="btn btn-ghost btn-sm" type="submit">Delete evidence now</button>
      </form>
    <% } %>
  </div>
</section>
<% } else if (attempt.evidence_purged_at) { %>
  <div class="alert alert-info">Proctoring evidence for this attempt was deleted on <%= fmtDateTime(attempt.evidence_purged_at) %>.</div>
<% } %>

<% if (attempt.review_status === 'pending') { %>
<section class="card mb-24 review-panel">
  <h2>Decision</h2>
  <form method="post" action="/admin/attempts/<%= attempt.id %>/review">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <div class="field"><label for="f-note">Note <span class="muted">(required to reject — the learner sees it)</span></label><input id="f-note" name="note" maxlength="300" placeholder="e.g. ID name does not match account, another person visible at 10:42"></div>
    <div class="row">
      <button class="btn btn-primary" type="submit" name="decision" value="approve">Approve and issue certificate</button>
      <button class="btn btn-danger" type="submit" name="decision" value="reject" data-confirm="Reject this attempt? It will be voided and the learner emailed.">Reject attempt</button>
    </div>
  </form>
</section>
<% } %>

<div class="grid-2">
  <section class="card">
    <h2>Session</h2>
    <dl class="meta">
      <dt>Started</dt><dd><%= fmtDateTime(attempt.started_at) %></dd>
      <dt>Deadline</dt><dd><%= fmtDateTime(attempt.expires_at) %></dd>
      <dt>Submitted</dt><dd><%= fmtDateTime(attempt.submitted_at) %><%= attempt.auto_submitted ? ` (auto: ${attempt.auto_submitted})` : '' %></dd>
      <dt>Duration</dt><dd><%= attempt.submitted_at ? Math.round((new Date(attempt.submitted_at) - new Date(attempt.started_at)) / 60000) + ' min' : '—' %></dd>
      <dt>Correct</dt><dd><%= attempt.correct_count ?? '—' %> / <%= attempt.question_ids.length %> (pass mark <%= attempt.pass_mark %>%)</dd>
      <dt>Warnings</dt><dd><%= attempt.focus_violations %><%= attempt.max_focus_violations ? ` of ${attempt.max_focus_violations} allowed` : '' %></dd>
      <dt>IP address</dt><dd><%= attempt.ip %></dd>
      <dt>Browser</dt><dd class="small"><%= attempt.user_agent %></dd>
      <% if (certificate) { %><dt>Certificate</dt><dd><a href="/certificates/<%= certificate.code %>.pdf" target="_blank" rel="noopener"><%= certificate.code %></a><%= certificate.revoked_at ? ' (revoked)' : '' %></dd><% } %>
      <% if (attempt.void_reason) { %><dt>Void reason</dt><dd><%= attempt.void_reason %></dd><% } %>
    </dl>
  </section>
  <section class="card">
    <h2>Integrity timeline</h2>
    <% if (!events.length) { %><p class="muted">No integrity events. The learner stayed on the exam throughout.</p><% } %>
    <ol class="timeline">
      <% for (const ev of events) { %>
        <li><time datetime="<%= new Date(ev.occurred_at).toISOString() %>"><%= new Date(ev.occurred_at).toLocaleTimeString('en-CA', { timeZone: 'America/Toronto' }) %></time>
          <span><%= labels[ev.kind] || ev.kind %><% if (ev.counted) { %> <span class="badge badge-warn">warning</span><% } else if (reviewKinds.includes(ev.kind)) { %> <span class="badge">check</span><% } %><% if (ev.detail) { %> <span class="small muted"><%= ev.detail %></span><% } %></span></li>
      <% } %>
    </ol>
  </section>
</div>

<% if (attempt.status !== 'voided' && user.role === 'admin') { %>
<section class="card danger-zone mt-24">
  <h2>Void this attempt</h2>
  <p class="muted">Use this when you're satisfied the learner cheated. The attempt counts as used and any certificate from it is revoked immediately.</p>
  <form method="post" action="/admin/attempts/<%= attempt.id %>/void" class="row" data-confirm="Void this attempt and revoke any certificate it produced?">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <input name="reason" class="grow" placeholder="Reason (recorded and shown to the learner)" maxlength="300" required aria-label="Reason">
    <button class="btn btn-danger" type="submit">Void attempt</button>
  </form>
</section>
<% } %>

<% if (snapshots.length) { %>
<h2 class="mt-32">Camera snapshots <span class="muted small">(<%= snapshots.length %>)</span></h2>
<div class="snapshots">
  <% for (const m of snapshots) { %>
    <figure class="<%= m.note && m.note !== 'start' ? 'flagged' : '' %>"><a href="/admin/media/<%= m.id %>" target="_blank" rel="noopener"><img src="/admin/media/<%= m.id %>" alt="Snapshot at <%= fmtDateTime(m.created_at) %>" loading="lazy"></a>
      <figcaption><%= new Date(m.created_at).toLocaleTimeString('en-CA', { timeZone: 'America/Toronto' }) %><%= m.note && m.note !== 'start' ? ` · ${labels[m.note] || m.note}` : '' %></figcaption></figure>
  <% } %>
</div>
<% } %>

<h2 class="mt-32">Answers</h2>
<% paper.forEach((q, i) => { %>
  <div class="card">
    <div class="spread"><strong>Q<%= i + 1 %>. <%= q.prompt %></strong><%- q.isRight ? '<span class="badge badge-ok">Correct</span>' : (q.answeredAt ? '<span class="badge badge-bad">Wrong</span>' : '<span class="badge">Unanswered</span>') %></div>
    <% for (const o of q.options) { %>
      <div class="answer-opt <%= o.is_correct ? 'correct' : (o.chosen ? 'chosen-wrong' : '') %>"><span><%= o.chosen ? '●' : '○' %></span><span><%= o.body %><%= o.is_correct ? ' ✓' : '' %></span></div>
    <% } %>
    <% if (q.answeredAt) { %><p class="small muted mt-8 mb-0">Answered <%= fmtDateTime(q.answeredAt) %></p><% } %>
  </div>
<% }) %>
<%- include('../partials/admin-end') %>
