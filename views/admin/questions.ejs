<%- include('../partials/admin-start') %>
<p class="crumb"><a href="/admin/courses/<%= course.id %>">← <%= course.title %></a></p>
<div class="page-head">
  <div>
    <h1 class="mb-8">Questions</h1>
    <p class="muted mb-0">
      <% if (poolFilter === 'exam') { %><%= counts.exam %> active final-exam questions · each exam draws <%= course.exam_question_count %> at random.
        <% if (counts.exam < course.exam_question_count * 2) { %>A bank at least twice the exam size makes answer-sharing much less useful.<% } %>
      <% } else { %><%= counts.quiz %> active quiz questions. Learners must answer each one correctly to move on. Explanations are shown after a correct answer.<% } %>
    </p>
  </div>
  <a class="btn btn-primary btn-sm" href="/admin/courses/<%= course.id %>/questions/new?pool=<%= poolFilter %>">New <%= poolFilter === 'quiz' ? 'quiz' : 'exam' %> question</a>
</div>
<nav class="tabs" aria-label="Question type">
  <a href="?pool=exam" <%- poolFilter === 'exam' ? 'aria-current="page"' : '' %>>Final exam bank (<%= counts.exam %>)</a>
  <a href="?pool=quiz" <%- poolFilter === 'quiz' ? 'aria-current="page"' : '' %>>Module quizzes (<%= counts.quiz %>)</a>
</nav>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Question</th><th><%= poolFilter === 'quiz' ? 'Module' : 'Topic' %></th><th>Type</th><th class="num">Options</th><th class="num">Times answered</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const q of questions) { %>
      <tr>
        <td class="wrap-text"><a href="/admin/questions/<%= q.id %>"><%= q.prompt.length > 120 ? q.prompt.slice(0, 117) + '…' : q.prompt %></a></td>
        <td><%= q.module_title || '—' %></td>
        <td><%= q.kind === 'multi' ? 'Multiple answers' : 'Single answer' %></td>
        <td class="num"><%= q.options %></td>
        <td class="num"><%= q.answered %></td>
        <td><%- q.is_active ? '<span class="badge badge-ok">Active</span>' : '<span class="badge">Retired</span>' %></td>
      </tr>
      <% } %>
      <% if (!questions.length) { %><tr><td colspan="6" class="muted">No questions yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<section class="card mt-32">
  <h2>Import <%= poolFilter === 'quiz' ? 'quiz' : 'exam' %> questions from CSV</h2>
  <p class="muted small">Paste rows with these columns: <code>prompt, option_a, option_b, option_c, option_d, correct, module, explanation</code>. <code>correct</code> is the letter of the right option (e.g. <code>B</code>), or several letters for multi-answer (e.g. <code>A;C</code>). <code>module</code> must match a module title<%= poolFilter === 'quiz' ? ' (required for quiz questions)' : ' to tag the topic' %>. A header row is optional.</p>
  <form method="post" action="/admin/courses/<%= course.id %>/questions/import">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <input type="hidden" name="pool" value="<%= poolFilter %>">
    <textarea name="csv" class="code" placeholder='"What is the temperature danger zone?","0°C to 60°C","4°C to 60°C","10°C to 50°C","4°C to 74°C",B,"Temperature control",'></textarea>
    <button class="btn btn-primary mt-16" type="submit">Import</button>
  </form>
</section>
<%- include('../partials/admin-end') %>
