<%- include('../partials/head') %>
<main id="main">
  <div class="page-band">
    <div class="wrap spread">
      <div>
        <p class="eyebrow"><a href="/dashboard">My learning</a></p>
        <h1><%= course.title %></h1>
      </div>
      <% const next = outline.next %>
      <% if (next) { %><a class="btn btn-primary btn-lg" href="<%= itemUrl(course.slug, next) %>"><%= outline.completed ? 'Continue' : 'Start Module 1' %> <%- include('../partials/icon', { name: 'arrow', cls: 'icon arrow' }) %></a>
      <% } else { %><a class="btn btn-primary btn-lg" href="/learn/<%= course.slug %>/exam"><%= status.certificate ? 'View your result' : 'Go to the final exam' %> <%- include('../partials/icon', { name: 'arrow', cls: 'icon arrow' }) %></a><% } %>
    </div>
  </div>
  <div class="page">
    <div class="wrap">
      <%- include('../partials/flash') %>
      <div class="lesson-layout">
        <%- include('../partials/lesson-nav', { currentKey: null }) %>
        <div class="lesson-body">
          <div class="progress-meta"><span><strong><%= outline.completed %></strong> of <%= outline.total %> chapters and quizzes complete</span><span class="mono"><%= outline.percent %>%</span></div>
          <progress class="bar mb-32" max="100" value="<%= outline.percent %>" aria-label="Course progress"></progress>
          <% if (status.certificate) { %>
            <div class="alert alert-success">You’re certified. <a href="/certificates/<%= status.certificate.code %>.pdf" target="_blank" rel="noopener">Download your certificate</a>.</div>
          <% } %>
          <div class="prose">
            <h2>How this course works</h2>
            <ol>
              <li>The course has <%= outline.modules.length %> modules. Each one is a chapter — a video and a written lesson — followed by a short quiz.</li>
              <li>Watch the video and spend the minimum study time on each chapter before marking it complete.</li>
              <li>In each quiz, answer every question correctly to move on. Quizzes aren’t timed or monitored.</li>
              <li>Modules unlock in order, and your progress saves automatically on any device.</li>
              <li>After the last quiz, the proctored final exam unlocks: <%= course.exam_time_limit_minutes %> minutes, <%= course.pass_mark %>% to pass, up to <%= course.max_attempts %> attempts.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
