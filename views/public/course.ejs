<%- include('../partials/head') %>
<% const years = course.certificate_validity_months ? Math.round(course.certificate_validity_months / 12 * 10) / 10 : null; %>
<main id="main">

  <section class="hero dark">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="kicker">Online certification course</p>
          <h1><%= course.title %>, <em>completed online.</em></h1>
          <p class="lead">One careless shortcut can make a customer sick and shut a kitchen down. This course teaches the rules that prevent it, then certifies you the moment you pass.</p>
          <div class="hero-actions">
            <%- include('../partials/enrol-cta', { cls: 'btn-ice btn-lg' }) %>
            <a class="btn btn-ghost btn-lg" href="#curriculum">See the curriculum</a>
          </div>
        </div>

        <aside class="enrol" id="enroll" aria-label="Enrol">
          <div class="enrol-head">
            <p class="eyebrow">Course, final exam &amp; certificate</p>
            <div class="price"><%= money(course.price_cents, course.currency) %><% if (course.price_cents) { %><small><%= course.currency.toUpperCase() %> + tax</small><% } %></div>
          </div>
          <div class="enrol-body">
            <ul class="enrol-list">
              <% for (const h of course.highlights) { %><li><%- include('../partials/icon', { name: 'check' }) %><span><%= h %></span></li><% } %>
            </ul>
            <%- include('../partials/enrol-cta', { cls: 'btn-primary btn-lg btn-block' }) %>
            <% if (!user) { %><p class="enrol-foot">Already registered? <a href="/login">Sign in</a></p>
            <% } else if (enrollment) { %><p class="enrol-foot"><%= outline.completed %> of <%= outline.total %> lessons complete</p><% } %>
          </div>
        </aside>
      </div>

      <dl class="spec-bar">
        <div><dt>Study time</dt><dd>About <%= duration(course.duration_minutes) %></dd></div>
        <div><dt>Format</dt><dd>Online, self-paced</dd></div>
        <div><dt>Final exam</dt><dd><%= examQuestions %> questions</dd></div>
        <div><dt>Certificate</dt><dd><%= years ? `Valid ${years} years` : 'No expiry' %></dd></div>
      </dl>
    </div>
  </section>

  <section class="assurance" aria-label="Why this course">
    <div class="wrap">
      <div class="assurance-grid">
        <div><%- include('../partials/icon', { name: 'qr' }) %><h3>Verifiable in seconds</h3><p>Every certificate has a unique number and QR code that employers can check online.</p></div>
        <div><%- include('../partials/icon', { name: 'book' }) %><h3>Built on Canadian standards</h3><p>Content follows Health Canada guidance and Ontario’s Food Premises Regulation.</p></div>
        <div><%- include('../partials/icon', { name: 'devices' }) %><h3>Learn on any device</h3><p>Phone, tablet or computer. Your progress saves as you go.</p></div>
        <div><%- include('../partials/icon', { name: 'shield' }) %><h3>An exam that means something</h3><p>Randomised questions and a monitored exam keep every certificate credible.</p></div>
      </div>
    </div>
  </section>

  <% if (course.outcomes.length) { %>
  <section class="section" id="outcomes">
    <div class="wrap split">
      <div class="split-head">
        <p class="kicker">01 — Outcomes</p>
        <h2>What you’ll be able to do</h2>
        <p>Practical rules you’ll use on every shift, explained plainly.</p>
      </div>
      <ol class="index-list">
        <% for (const o of course.outcomes) { %><li><%= o %></li><% } %>
      </ol>
    </div>
  </section>
  <% } %>

  <section class="section section-white section-rule" id="curriculum">
    <div class="wrap split">
      <div class="split-head">
        <p class="kicker">02 — Curriculum</p>
        <h2><%= outline.modules.length %> modules, one clear path</h2>
        <p><%= outline.total %> lessons, about <%= duration(course.duration_minutes) %> in total. Lessons unlock in order, so nothing important gets skipped.</p>
      </div>
      <div>
        <div class="curriculum">
          <% outline.modules.forEach((m, i) => { %>
          <details <%= i === 0 ? 'open' : '' %>>
            <summary>
              <span class="mod-n"><%= String(i + 1).padStart(2, '0') %></span>
              <span class="mod-title"><%= m.title %></span>
              <span class="mod-meta"><%= m.lessons.length %> lesson<%= m.lessons.length === 1 ? '' : 's' %></span>
            </summary>
            <ol><% m.lessons.forEach((l, j) => { %><li><span><%= i + 1 %>.<%= j + 1 %></span><%= l.title %></li><% }) %></ol>
          </details>
          <% }) %>
        </div>
        <% if (descriptionHtml) { %><div class="prose mt-48"><%- descriptionHtml %></div><% } %>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="split mb-32">
        <div><p class="kicker">03 — How it works</p></div>
        <h2 class="mb-0">From sign-up to certificate, without leaving your browser.</h2>
      </div>
      <ol class="steps">
        <li><h3>Create your account</h3><p>Register with your legal name. It’s printed on your certificate.</p></li>
        <li><h3>Study the lessons</h3><p>Work through each module at your own pace. Your place is saved on every device.</p></li>
        <li><h3>Pass the final exam</h3><p><%= examQuestions %> questions in <%= course.exam_time_limit_minutes %> minutes. <%= course.pass_mark %>% to pass, <%= course.max_attempts %> attempts included.</p></li>
        <li><h3>Download your certificate</h3><p>Issued instantly as a PDF, with a QR code employers can scan.</p></li>
      </ol>
    </div>
  </section>

  <section class="section dark" id="certificate">
    <div class="wrap showcase">
      <figure>
        <picture>
          <source srcset="/img/certificate-sample.webp" type="image/webp">
          <img src="/img/certificate-sample.jpg" alt="Sample High Vault Security food handler certificate showing the learner’s name, course, score, issue and expiry dates, certificate number and QR code" width="1400" height="1082" loading="lazy" decoding="async">
        </picture>
        <figcaption>Sample certificate</figcaption>
      </figure>
      <div>
        <p class="kicker">04 — Exam &amp; certificate</p>
        <h2>A certificate employers can check.</h2>
        <p class="lead">Each certificate carries a unique number and QR code. Anyone can confirm it’s genuine, current and issued to you.</p>
        <dl class="facts-list">
          <div><dt>Final exam</dt><dd><%= examQuestions %> multiple-choice questions</dd></div>
          <div><dt>Time limit</dt><dd><%= course.exam_time_limit_minutes %> minutes</dd></div>
          <div><dt>Pass mark</dt><dd><%= course.pass_mark %>%</dd></div>
          <div><dt>Attempts included</dt><dd><%= course.max_attempts %></dd></div>
          <div><dt>Certificate</dt><dd>Instant PDF<%= years ? `, valid ${years} years` : '' %></dd></div>
        </dl>
        <a class="btn btn-ghost" href="/verify">Verify a certificate <%- include('../partials/icon', { name: 'arrow', cls: 'icon arrow' }) %></a>
      </div>
    </div>
  </section>

  <% if (course.faqs.length) { %>
  <section class="section section-white" id="faq">
    <div class="wrap split">
      <div class="split-head">
        <p class="kicker">05 — Questions</p>
        <h2>Before you enrol</h2>
        <p class="contact-line">Still have a question? Email <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.</p>
      </div>
      <div class="faq">
        <% for (const f of course.faqs) { %>
          <details><summary><%= f.q %></summary><p><%= f.a %></p></details>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="closing dark">
    <div class="wrap closing-grid">
      <h2>Start today. Your certificate is issued the moment you pass.</h2>
      <div class="closing-actions">
        <%- include('../partials/enrol-cta', { cls: 'btn-ice btn-lg' }) %>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/foot') %>
